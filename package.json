    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.5",
